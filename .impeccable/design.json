      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;color:var(--color-primary,#214b48);padding:4px 9px;background:var(--color-secondary,#e2eee6);border:0;border-radius:5px;font:12px \"DM Sans\",sans-serif;cursor:pointer;transition:background-color 180ms ease;}.ds-chip:hover{background:#cbded0;}.ds-chip:focus-visible{outline:2px solid var(--focus,#347769);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-chip{transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important;}}"
    },
    {
      "name": "Product Reading Surface",
      "kind": "card",
      "refersTo": "product-card",
      "description": "Paper product-card shell and source-matched title/price rows; product artwork is intentionally omitted from this primitive.",
      "html": "<article class=\"ds-card\"><p class=\"ds-maker\">Roland</p><h3 class=\"ds-card-title\">FP-10</h3><p class=\"ds-subtitle\">Illustrative product and price</p><div class=\"ds-price\"><span><strong>$599</strong> listed</span><span>$829 setup</span></div></article>",
      "css": ".ds-card{background:var(--paper,#fffefa);color:var(--ink,#182b2c);border:1px solid var(--line,#d9ded8);border-radius:12px;overflow:hidden;padding:18px 18px 16px;transition:border-color 200ms ease,box-shadow 200ms ease;}.ds-card:hover{border-color:#a9bcb0;}.ds-maker{font:600 12px \"DM Sans\",sans-serif;color:#566b5b;letter-spacing:.025em;margin:0 0 4px;}.ds-card-title{font:500 21px/1.1 \"Space Grotesk\",sans-serif;letter-spacing:-.035em;margin:0;}.ds-subtitle{font:12px/1.6 \"DM Sans\",sans-serif;color:var(--muted,#566463);margin:6px 0 18px;}.ds-price{display:flex;justify-content:space-between;gap:8px;align-items:baseline;font:12px \"DM Sans\",sans-serif;color:#53655a;}.ds-price strong{font:500 21px \"Space Grotesk\",sans-serif;color:var(--ink,#182b2c);}.ds-price>span:last-child{color:#234a40;}@media(max-width:600px){.ds-card{padding:20px;}.ds-card-title{font-size:24px;}}@media(prefers-reduced-motion:reduce){.ds-card,.ds-card-title,.ds-maker,.ds-price,.ds-subtitle{transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important;}}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "description": "The actual header action and demo badge; no invented tabs or active route state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><button class=\"ds-how\">How it works<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button><span class=\"ds-demo\"><i class=\"ds-dot\"></i>BuildYYC demo</span></nav>",
      "css": ".ds-nav{display:flex;gap:24px;align-items:center;}.ds-how{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;height:36px;padding:8px 16px;font:500 14px 'DM Sans',sans-serif;white-space:nowrap;cursor:pointer;transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease,box-shadow 180ms ease;color:var(--muted,#566463);background:transparent;border:0;font-size:13px;}.ds-how:hover{background:var(--color-accent,#d9eeea);color:var(--color-accent-foreground,#173b3c);}.ds-how:focus-visible{outline:2px solid var(--focus,#347769);outline-offset:4px;}.ds-demo{display:inline-flex;align-items:center;padding:8px 12px;gap:7px;color:#425950;font:500 12px \"DM Sans\",sans-serif;border:1px solid var(--line,#d9ded8);border-radius:9999px;white-space:nowrap;}.ds-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#408577;}@media(max-width:850px){.ds-nav{gap:10px;}.ds-how{font-size:12px;}}@media(max-width:600px){.ds-demo{display:none;}.ds-nav{gap:0;}}@media(prefers-reduced-motion:reduce){.ds-demo,.ds-dot,.ds-how,.ds-nav{transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important;}}"
    }
